  "queries": {
    "finance_by_currency": {
      "statement": "SELECT currency, SUM(amount) AS amount FROM `erp_demo`.`erp_connector_demo_v1`.`finance_lines` WHERE company_code = :company_code GROUP BY currency ORDER BY currency",
      "parameters": [
        {
          "name": "company_code",
          "type": "STRING"
        }
      ]
    },
    "overdue_receivables": {
      "statement": "SELECT currency, SUM(outstanding_amount) AS amount FROM `erp_demo`.`erp_connector_demo_v1`.`receivables` WHERE company_code = :company_code AND due_date < :as_of_date AND outstanding_amount > 0 AND disputed = false GROUP BY currency ORDER BY currency",
      "parameters": [
        {
          "name": "company_code",
          "type": "STRING"
        },
        {
          "name": "as_of_date",
          "type": "DATE"
        }
      ]
    },
    "overdue_payables": {
      "statement": "SELECT currency, SUM(outstanding_amount) AS amount FROM `erp_demo`.`erp_connector_demo_v1`.`payables` WHERE company_code = :company_code AND due_date < :as_of_date AND outstanding_amount > 0 GROUP BY currency ORDER BY currency",
      "parameters": [
        {
          "name": "company_code",
          "type": "STRING"
        },
        {
          "name": "as_of_date",
          "type": "DATE"
        }
      ]
    },
    "inventory_valuation": {
      "statement": "SELECT currency, SUM(quantity * unit_cost) AS known_value, SUM(CASE WHEN unit_cost IS NULL THEN 1 ELSE 0 END) AS missing_cost_rows FROM `erp_demo`.`erp_connector_demo_v1`.`inventory_positions` WHERE company_code = :company_code GROUP BY currency ORDER BY currency",
      "parameters": [
        {
          "name": "company_code",
          "type": "STRING"
        }
      ]
    },
    "open_sales_orders": {
      "statement": "SELECT currency, SUM(amount) AS amount FROM `erp_demo`.`erp_connector_demo_v1`.`sales_orders` WHERE company_code = :company_code AND status = 'OPEN' GROUP BY currency ORDER BY currency",
      "parameters": [
        {
          "name": "company_code",
          "type": "STRING"
        }
      ]
    },
    "open_purchase_orders": {
      "statement": "SELECT currency, SUM(amount) AS amount FROM `erp_demo`.`erp_connector_demo_v1`.`purchase_orders` WHERE company_code = :company_code AND status = 'OPEN' GROUP BY currency ORDER BY currency",
      "parameters": [
        {
          "name": "company_code",
          "type": "STRING"
        }
      ]
    }
  },
  "limits": {
    "max_rows": 1000,
    "max_bytes": 4000000,
    "timeout_seconds": 120
  }
}
