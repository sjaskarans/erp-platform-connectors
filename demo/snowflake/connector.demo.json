  "queries": {
    "finance_by_currency": {
      "statement": "SELECT currency, SUM(amount) AS amount FROM \"ERP_DEMO\".\"ERP_CONNECTOR_DEMO_V1\".\"FINANCE_LINES\" WHERE company_code = ? GROUP BY currency ORDER BY currency",
      "parameters": [
        {
          "name": "company_code",
          "type": "STRING"
        }
      ]
    },
    "overdue_receivables": {
      "statement": "SELECT currency, SUM(outstanding_amount) AS amount FROM \"ERP_DEMO\".\"ERP_CONNECTOR_DEMO_V1\".\"RECEIVABLES\" WHERE company_code = ? AND due_date < ? AND outstanding_amount > 0 AND disputed = false GROUP BY currency ORDER BY currency",
      "parameters": [
        {
          "name": "company_code",
          "type": "STRING"
        },
        {
          "name": "as_of_date",
          "type": "DATE"
        }
      ]
    },
    "overdue_payables": {
      "statement": "SELECT currency, SUM(outstanding_amount) AS amount FROM \"ERP_DEMO\".\"ERP_CONNECTOR_DEMO_V1\".\"PAYABLES\" WHERE company_code = ? AND due_date < ? AND outstanding_amount > 0 GROUP BY currency ORDER BY currency",
      "parameters": [
        {
          "name": "company_code",
          "type": "STRING"
        },
        {
          "name": "as_of_date",
          "type": "DATE"
        }
      ]
    },
    "inventory_valuation": {
      "statement": "SELECT currency, SUM(quantity * unit_cost) AS known_value, SUM(CASE WHEN unit_cost IS NULL THEN 1 ELSE 0 END) AS missing_cost_rows FROM \"ERP_DEMO\".\"ERP_CONNECTOR_DEMO_V1\".\"INVENTORY_POSITIONS\" WHERE company_code = ? GROUP BY currency ORDER BY currency",
      "parameters": [
        {
          "name": "company_code",
          "type": "STRING"
        }
      ]
    },
    "open_sales_orders": {
      "statement": "SELECT currency, SUM(amount) AS amount FROM \"ERP_DEMO\".\"ERP_CONNECTOR_DEMO_V1\".\"SALES_ORDERS\" WHERE company_code = ? AND status = 'OPEN' GROUP BY currency ORDER BY currency",
      "parameters": [
        {
          "name": "company_code",
          "type": "STRING"
        }
      ]
    },
    "open_purchase_orders": {
      "statement": "SELECT currency, SUM(amount) AS amount FROM \"ERP_DEMO\".\"ERP_CONNECTOR_DEMO_V1\".\"PURCHASE_ORDERS\" WHERE company_code = ? AND status = 'OPEN' GROUP BY currency ORDER BY currency",
      "parameters": [
        {
          "name": "company_code",
          "type": "STRING"
        }
      ]
    }
  },
  "limits": {
    "max_rows": 1000,
    "max_bytes": 4000000,
    "timeout_seconds": 120
  }
