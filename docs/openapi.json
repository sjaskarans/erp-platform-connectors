  "components": {
    "schemas": {
      "BrowseInput": {
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "databases",
              "schemas",
              "objects",
              "columns"
            ],
            "title": "Level"
          },
          "database": {
            "type": "string",
            "maxLength": 255,
            "title": "Database",
            "default": ""
          },
          "schema_name": {
            "type": "string",
            "maxLength": 255,
            "title": "Schema Name",
            "default": ""
          },
          "table": {
            "type": "string",
            "maxLength": 255,
            "title": "Table",
            "default": ""
          },
          "after": {
            "type": "string",
            "maxLength": 255,
            "title": "After",
            "default": ""
          },
          "prefix": {
            "type": "string",
            "maxLength": 255,
            "title": "Prefix",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "level"
        ],
        "title": "BrowseInput"
      },
      "ConnectionInput": {
        "properties": {
          "platform": {
            "type": "string",
            "const": "databricks",
            "title": "Platform",
            "default": "databricks"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "workspace_url": {
            "type": "string",
            "maxLength": 255,
            "title": "Workspace Url"
          },
          "warehouse_id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{8,64}$",
            "title": "Warehouse Id"
          },
          "client_id": {
            "type": "string",
            "maxLength": 36,
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096,
                "minLength": 8,
                "format": "password",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Secret"
          },
          "objects": {
            "items": {
              "$ref": "#/components/schemas/ObjectInput"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Objects"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "workspace_url",
          "warehouse_id",
          "client_id",
          "objects"
        ],
        "title": "ConnectionInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ObjectInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Name"
          },
          "catalog": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Catalog"
          },
          "schema_name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Schema Name"
          },
          "table_name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Table Name"
          },
          "preview_columns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Preview Columns"
          },
          "object_kind": {
            "type": "string",
            "enum": [
              "TABLE",
              "VIEW"
            ],
            "title": "Object Kind",
            "default": "TABLE"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "catalog",
          "schema_name",
          "table_name"
        ],
        "title": "ObjectInput"
      },
      "ObjectSelectionInput": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "objects": {
            "items": {
              "$ref": "#/components/schemas/ObjectInput"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Objects"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "objects"
        ],
        "title": "ObjectSelectionInput"
      },
      "QueryInput": {
        "properties": {
          "parameters": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Parameters"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "parameters"
        ],
        "title": "QueryInput"
      },
      "RedshiftConnectionInput": {
        "properties": {
          "platform": {
            "type": "string",
            "const": "redshift",
            "title": "Platform"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "region": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z]{2}(?:-[a-z0-9]+)+-\\d+$",
            "title": "Region"
          },
          "deployment": {
            "type": "string",
            "enum": [
              "serverless",
              "provisioned"
            ],
            "title": "Deployment"
          },
          "database": {
            "type": "string",
            "maxLength": 127,
            "minLength": 1,
            "title": "Database"
          },
          "workgroup_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 3,
                "pattern": "^[a-z0-9-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workgroup Name"
          },
          "cluster_identifier": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 63,
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cluster Identifier"
          },
          "aws_profile": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_.@+-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aws Profile"
          },
          "objects": {
            "items": {
              "$ref": "#/components/schemas/ObjectInput"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Objects"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "platform",
          "name",
          "region",
          "deployment",
          "database"
        ],
        "title": "RedshiftConnectionInput"
      },
      "SnowflakeAccessScope": {
        "properties": {
          "catalog": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Catalog"
          },
          "schema_name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Schema Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "catalog",
          "schema_name"
        ],
        "title": "SnowflakeAccessScope"
      },
      "SnowflakeConnectionInput": {
        "properties": {
          "platform": {
            "type": "string",
            "const": "snowflake",
            "title": "Platform"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "account": {
            "type": "string",
            "maxLength": 255,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*[A-Za-z0-9]$",
            "title": "Account"
          },
          "warehouse": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Warehouse"
          },
          "username": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Username"
          },
          "role": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Role"
          },
          "private_key_pem": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 16000,
                "format": "password",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Private Key Pem"
          },
          "private_key_passphrase": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096,
                "format": "password",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Private Key Passphrase"
          },
          "objects": {
            "items": {
              "$ref": "#/components/schemas/ObjectInput"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Objects"
          },
          "access_scope": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SnowflakeAccessScope"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "platform",
          "name",
          "account",
          "warehouse",
          "username",
          "role"
        ],
        "title": "SnowflakeConnectionInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
